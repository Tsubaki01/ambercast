---
import { browserMarkup, planMarkup, promptMarkup } from '../scripts/demo-markup.ts';
import type { LandingCopy } from '../content/en-landing.ts';

interface Props {
  labels: LandingCopy['demo'];
}

const { labels } = Astro.props;
---

<!-- The terminal fallback remains complete without client code; its done phase also supplies a deterministic browser spotlight. -->
<section id="ambercast-demo" class="landing-demo" aria-label={labels.tryIt} data-demo-lit="browser" data-run-label={labels.run} data-run-again-label={labels.runAgain}>
  <header class="demo-header">
    <span class="ac-label">FIG. 2 · TRY IT · NO INSTALL</span>
    <div id="demo-counter">RUNS 1 · AI CALLS 1</div>
  </header>
  <div class="demo-stage">
    <!-- Wrappers are grid items while ids stay inside, so panel replacement cannot destroy exhibit placement. -->
    <div class="landing-exhibit" data-exhibit="prompt"><section id="demo-prompt-panel" class="demo-panel">
      <Fragment set:html={promptMarkup()} />
    </section></div>
    <button id="demo-generate" class="demo-action" type="button" disabled>{labels.generate}</button>
    <div class="landing-exhibit" data-exhibit="plan"><section id="demo-plan-panel" class="demo-panel">
      <Fragment set:html={planMarkup('done')} />
    </section></div>
    <button id="demo-run" class="demo-action" type="button" disabled>{labels.runAgain}</button>
    <div class="landing-exhibit" data-exhibit="browser"><section id="demo-browser-panel" class="demo-panel demo-browser-panel">
      <Fragment set:html={browserMarkup('done')} />
    </section></div>
  </div>
  <div class="demo-status-row">
    <span id="demo-status" aria-live="polite">NO. 001 · LOGIN · 6/6 STEPS · 2.4S · 0 AI CALLS · EXIT 0</span>
    <button id="demo-reset" type="button" disabled>{labels.reset}</button>
  </div>
</section>

<script>
  import { attach } from '../scripts/demo-adapter';

  const root = document.getElementById('ambercast-demo');
  if (root instanceof HTMLElement) {
    try {
      attach(root);
    } catch {
      // The server-rendered terminal state remains usable when client enhancement cannot start.
    }
  }
</script>

<style is:global>
  /* Geometry is shared; dark-only selectors carry lighting so the light demo remains token-driven and flat. */
  .landing-demo{display:grid;gap:1rem;margin:0 auto;padding:1rem 0 4rem}
  .demo-header,.demo-status-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}.demo-header>div{font:500 var(--sl-text-sm)/1 var(--sl-font-mono);color:var(--sl-color-gray-3)}
  /* Starlight's broad markdown sibling rule applies inside landing grids, so each direct layout child resets that inherited margin and gaps remain the sole spacing mechanism. */
  .landing-page>*,.landing-hero>*,.landing-flow>*,.landing-section>*,.landing-ledger>*,.landing-prerequisites dl>*,.landing-demo>*,.demo-stage>*,.demo-panel>*,.landing-exhibit>*{margin-top:0}.demo-stage{display:grid;/* Long localized labels can widen each gutter to their max-content width. */grid-template-columns:minmax(0,.8fr) minmax(132px,max-content) minmax(0,1.55fr) minmax(132px,max-content) minmax(0,1fr);margin-top:20px;align-items:stretch}.landing-demo .landing-exhibit{display:grid;min-width:0}
  .demo-panel{display:grid;grid-template-rows:auto minmax(0,1fr) auto;min-width:0;min-height:0;border:1px solid var(--sl-color-hairline);border-radius:14px;background:var(--sl-color-gray-6);overflow:hidden}.demo-panel>header,.demo-panel>footer{display:flex;justify-content:space-between;gap:.75rem;padding:12px 16px;font:500 var(--sl-text-xs)/1.2 var(--sl-font-mono);color:var(--sl-color-gray-3)}.demo-panel>header{align-items:center;border-bottom:1px solid var(--sl-color-hairline);color:var(--sl-color-gray-1)}.demo-panel>footer{min-height:20px;padding:10px 16px;border-top:1px solid var(--sl-color-hairline);overflow-wrap:anywhere}.demo-panel pre{min-height:0;margin:0;padding:1rem;white-space:pre-wrap;overflow:auto;overflow-wrap:anywhere;font:500 11.5px/1.7 var(--sl-font-mono);color:var(--sl-color-gray-2)}#demo-prompt-panel pre{font-size:13px;line-height:1.75}.demo-prompt-heading{font-weight:600}.demo-plan-empty{display:grid;place-items:center;padding:1.5rem;color:var(--sl-color-gray-4);font:500 var(--sl-text-xs)/1.6 var(--sl-font-mono);letter-spacing:.12em;text-align:center;text-transform:uppercase}.demo-plan-line{display:grid;grid-template-columns:1rem minmax(0,1fr);gap:.375rem;opacity:0;transform:translateY(4px);transition:opacity .25s,transform .25s}.demo-plan-line-visible{opacity:1;transform:none}.demo-plan-marker{color:var(--sl-color-gray-4);font-style:normal;text-align:center}.demo-plan-marker-active{color:var(--sl-color-white)}.demo-plan-marker-ok{color:var(--sl-color-green-high)}
  .demo-pill{display:inline-flex;align-items:center;flex:none;border-radius:999px;padding:.25rem .45rem;background:var(--sl-color-gray-5);font-size:.65rem;color:var(--sl-color-gray-2)}.demo-pill::before{width:.375rem;height:.375rem;margin-right:.35rem;border-radius:50%;background:currentColor;content:""}.demo-pill-ai{background:var(--sl-color-orange-low);color:var(--sl-color-orange-high)}.demo-pill-ai::before{animation:demo-casting-blink 1s step-end infinite}.demo-pill-ok{background:var(--sl-color-green-low);color:var(--sl-color-green-high)}
  /* Grid items default to justify-self: stretch, so center the buttons and preserve an 8px panel gutter even for long labels. */
  .demo-action{align-self:center;justify-self:center;min-height:44px;margin:0 8px;border:1px solid var(--sl-color-gray-4);border-bottom-width:3px;border-radius:10px;padding:.5rem .75rem;background:var(--sl-color-gray-6);color:var(--sl-color-white);font:700 .9rem/1 var(--sl-font);cursor:pointer}.demo-action-hint{animation:demo-action-hint-ring 1.4s infinite}.demo-action:not(:disabled):hover,.demo-status-row button:not(:disabled):hover{border-color:var(--sl-color-gray-3)}.demo-action:active,.demo-status-row button:active{border-bottom-width:1px;transform:translateY(2px)}.demo-action:disabled,.demo-status-row button:disabled{cursor:not-allowed;opacity:.55}
  .demo-browser{position:relative;min-height:0;background:var(--ac-code-bg);overflow:hidden}.demo-browser-dim{opacity:.45}.demo-browser-url{display:flex;align-items:center;gap:.5rem;height:34px;padding:0 .75rem;border-bottom:1px solid var(--sl-color-hairline);font:500 .6875rem/1 var(--sl-font-mono);color:var(--sl-color-gray-3)}.demo-browser-url>span:last-child{min-width:0;flex:1;border-radius:6px;padding:.25rem .625rem;background:var(--sl-color-gray-6);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.demo-browser-dots{display:flex;gap:.25rem}.demo-browser-dots i{width:7px;height:7px;border-radius:50%;background:var(--sl-color-gray-5)}.demo-browser-app{padding:1.75rem 2rem}.demo-browser-app h3{margin:0 0 1rem;color:var(--sl-color-white);font-size:1.125rem;letter-spacing:-.02em}.demo-field{display:grid;gap:.25rem;margin-bottom:.75rem;color:var(--sl-color-gray-3);font-size:.75rem}.demo-input{display:flex;align-items:center;height:36px;border:1px solid var(--sl-color-gray-5);border-radius:8px;padding:0 .625rem;background:var(--sl-color-black);color:var(--sl-color-gray-1);font-size:.8125rem}.demo-sign-in{display:inline-flex;align-items:center;height:36px;border-radius:8px;padding:0 1rem;background:var(--sl-color-gray-1);color:var(--sl-color-black);font-size:.8125rem;font-weight:700}.demo-run-browser .demo-input,.demo-run-browser .demo-sign-in{animation:demo-replay-pulse .45s ease both}.demo-check{border-radius:4px;padding:.125rem .375rem;background:var(--sl-color-green-low);color:var(--sl-color-green-high)}.demo-dashboard>i{display:block;width:70%;height:10px;margin-top:.5rem;border-radius:5px;background:var(--sl-color-gray-6)}.demo-dashboard>i:nth-of-type(2){width:50%}.demo-dashboard>i:nth-of-type(3){width:60%}@keyframes demo-replay-pulse{from{opacity:.45}to{opacity:1}}
  .demo-sign-in-pressed{transform:scale(.96);background:var(--sl-color-gray-3)}@keyframes demo-action-hint-ring{from{outline:2px solid rgba(158,145,132,.8);outline-offset:2px}to{outline:2px solid transparent;outline-offset:12px}}@keyframes demo-casting-blink{0%,49%{opacity:1}50%,100%{opacity:0}}
  .demo-status-row{padding-top:14px;font:500 var(--sl-text-xs)/1.35 var(--sl-font-mono);color:var(--sl-color-gray-3)}.demo-status-row button{min-height:44px;border:1px solid var(--sl-color-hairline);border-radius:8px;padding:.45rem .7rem;background:transparent;color:var(--sl-color-gray-1);font:inherit;cursor:pointer}
  [data-theme="dark"] .landing-demo[data-demo-lit="prompt"] .landing-exhibit[data-exhibit="prompt"]::before{}[data-theme="dark"] .landing-demo[data-demo-lit="plan"] .landing-exhibit[data-exhibit="plan"]::before{}[data-theme="dark"] .landing-demo[data-demo-lit="browser"] .landing-exhibit[data-exhibit="browser"]::before{}[data-theme="dark"] .landing-demo[data-demo-lit="prompt"] [data-exhibit="prompt"] .demo-panel{}[data-theme="dark"] .landing-demo[data-demo-lit="plan"] [data-exhibit="plan"] .demo-panel{}[data-theme="dark"] .landing-demo[data-demo-lit="browser"] [data-exhibit="browser"] .demo-panel{}
  @media (min-width:50rem){.demo-panel{min-height:380px}}@media (max-width:71.99rem){.demo-stage{grid-template-columns:1fr 1fr;gap:1rem}.demo-action,[data-exhibit="browser"]{grid-column:1/-1;width:100%}.demo-action{justify-self:stretch;margin:0}}@media (max-width:49.99rem){.demo-stage{grid-template-columns:1fr;gap:14px}.demo-action,[data-exhibit="browser"]{grid-column:auto}.landing-demo{padding:1rem 0 2.5rem}.demo-header,.demo-status-row{align-items:flex-start;flex-direction:column}#demo-plan-panel pre{font-size:10.5px}}
  .demo-plan-line{grid-template-columns:16px minmax(0,1fr);gap:6px}.demo-pill{height:22px;padding:0 9px;font:700 11px/1 var(--sl-font-mono);letter-spacing:.04em}.demo-pill::before{width:7px;height:7px;margin-right:5px}.demo-action{padding:0 14px;font-size:15px;white-space:nowrap}
  [data-theme="dark"] .demo-panel>header,[data-theme="dark"] .demo-panel>footer{background:rgba(16,12,9,.35);color:var(--ac-resin-300)}[data-theme="dark"] .demo-panel>header{border-bottom-color:rgba(201,118,43,.32);color:var(--sl-color-gray-1)}[data-theme="dark"] .demo-panel>footer{border-top-color:rgba(166,92,31,.28)}[data-theme="dark"] .demo-panel pre{color:var(--sl-color-gray-1)}[data-theme="dark"] .demo-prompt-heading,[data-theme="dark"] .demo-prompt-body{color:var(--sl-color-gray-1)}[data-theme="dark"] .demo-prompt-grant,[data-theme="dark"] .demo-json-key{color:var(--ac-resin-300)}[data-theme="dark"] .demo-json-value{color:var(--ac-resin-0)}[data-theme="dark"] .demo-status-row{border-top:1px dashed rgba(166,92,31,.28)}[data-theme="dark"] .demo-browser{background:#100C09}
  [data-theme="dark"] .demo-panel{background:linear-gradient(180deg,rgba(201,118,43,.16),rgba(201,118,43,.04) 45%,transparent 75%),#2E2620;border-color:rgba(201,118,43,.38);box-shadow:0 1px 0 rgba(241,205,152,.35) inset,0 0 0 1px rgba(16,12,9,.9),0 28px 60px -24px rgba(0,0,0,.95);transition:box-shadow .6s,border-color .6s}[data-theme="dark"] .landing-demo[data-demo-lit="prompt"] [data-exhibit="prompt"] .demo-panel,[data-theme="dark"] .landing-demo[data-demo-lit="plan"] [data-exhibit="plan"] .demo-panel,[data-theme="dark"] .landing-demo[data-demo-lit="browser"] [data-exhibit="browser"] .demo-panel{border-color:rgba(232,176,99,.85);box-shadow:0 1px 0 rgba(241,205,152,.6) inset,0 0 0 1px rgba(16,12,9,.9),0 0 0 4px rgba(201,118,43,.10),0 28px 70px -24px rgba(201,118,43,.45)}[data-theme="dark"] .landing-demo[data-demo-lit="prompt"] .landing-exhibit[data-exhibit="prompt"]::before,[data-theme="dark"] .landing-demo[data-demo-lit="plan"] .landing-exhibit[data-exhibit="plan"]::before,[data-theme="dark"] .landing-demo[data-demo-lit="browser"] .landing-exhibit[data-exhibit="browser"]::before{background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(232,176,99,.44),rgba(201,118,43,.12) 50%,transparent 80%)}[data-theme="dark"] .demo-action{background:linear-gradient(180deg,rgba(201,118,43,.14),transparent),#3B332C;border-color:rgba(166,92,31,.5)}[data-theme="dark"] .demo-action:disabled{background:#3B332C;box-shadow:none;opacity:.35}[data-theme="dark"] .demo-action:not(:disabled):hover{background:#554B42;border-color:#766B60}
  /* This final, equally specific override follows every transition declaration so reduced motion cannot be restored by a later lighting rule. */
  @media (prefers-reduced-motion:reduce){.demo-action-hint,.demo-pill-ai::before{animation:none}[data-theme] .demo-panel,.demo-panel{transition:none}}
</style>
