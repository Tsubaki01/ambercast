---
import Demo from './Demo.astro';
import type { LandingCopy } from '../content/en-landing.ts';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mark = `${base}ambercast-mark.svg`;
---

<!-- Landing copy lives outside this reusable layout so locale-specific data reuses its structural contract without duplicating markup. -->
<div class="landing-page">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-copy">
      <img class="landing-mark" src={mark} alt="" width="72" height="72" />
      <p class="ac-label">{copy.hero.eyebrow}</p>
      <h1 id="landing-title">{copy.hero.title}</h1>
      <p class="landing-summary">{copy.hero.summary}</p>
      <div class="landing-actions">
        <a class="landing-cta" href={`${base}guides/getting-started/`}>{copy.hero.primaryCta}</a>
        <code><span aria-hidden="true" class="landing-prompt">$</span>{copy.hero.installCommand}</code>
      </div>
    </div>
    <figure class="landing-figure-one">
      <div class="landing-flow">
        <div class="landing-node"><strong>{copy.figureOne.sourceNode}</strong><span>{copy.figureOne.sourceCaption}</span></div>
        <p class="landing-arrow landing-arrow-ai">{copy.figureOne.generateLabel} →<span>{copy.figureOne.generateCallout}</span></p>
        <div class="landing-node landing-node-hot"><strong>{copy.figureOne.castNode}</strong><span>plan.json<br />grounding.json</span></div>
        <p class="landing-arrow landing-arrow-ok">{copy.figureOne.runLabel} →<span>{copy.figureOne.runCallout}</span></p>
        <div class="landing-node landing-node-cool"><strong>{copy.figureOne.replayNode}</strong><span>6/6 · 2.4s</span></div>
      </div>
      <p class="landing-heal-pill">{copy.figureOne.healPill}</p>
      <figcaption class="ac-label">{copy.figureOne.caption}</figcaption>
    </figure>
  </section>
  <Demo />
  <section class="landing-section landing-commands" aria-labelledby="commands-heading">
    <div><p class="ac-label">{copy.commands.eyebrow}</p><h2 id="commands-heading">{copy.commands.heading}</h2></div>
    <div class="landing-ledger">
      {copy.commands.rows.map((row) => (
        <article class="landing-ledger-row">
          <span>{row.number}</span><code>{row.command}</code><p>{row.description}</p><b class:list={{ 'landing-ledger-ai': row.status.startsWith('AI'), 'landing-ledger-ok': row.status.startsWith('REPLAY') }}>{row.status}</b>
        </article>
      ))}
    </div>
  </section>
  <section class="landing-section landing-prerequisites" aria-labelledby="prerequisites-heading">
    <div><p class="ac-label">{copy.prerequisites.eyebrow}</p><h2 id="prerequisites-heading">{copy.prerequisites.heading}</h2><p>{copy.prerequisites.summary}</p></div>
    <dl>
      {copy.prerequisites.entries.map((entry) => <><dt>{entry.term}</dt><dd>{entry.description}</dd></>)}
    </dl>
  </section>
  <footer class="landing-footer">
    <nav aria-label="Project links"><a href="https://github.com/Tsubaki01/ambercast">{copy.footer.github}</a><a href="https://www.npmjs.com/package/ambercast">{copy.footer.npm}</a><a href="https://github.com/Tsubaki01/ambercast/blob/main/CHANGELOG.md">{copy.footer.changelog}</a><span>{copy.footer.license}</span></nav>
    <span class="ac-label">{copy.footer.specimen}</span>
  </footer>
</div>

<style is:global>
  .landing-page{width:min(100% - 6rem,84rem);margin:0 auto;padding:4.5rem 0 2rem}.landing-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,600px);gap:4rem;align-items:center;padding:0 0 3.5rem;overflow:hidden}.landing-hero::before{position:absolute;z-index:-1;top:-220px;right:0;width:520px;height:520px;background:radial-gradient(closest-side,rgba(201,118,43,.18),transparent);content:""}.landing-hero-copy{display:grid;align-content:start;justify-items:start;gap:1.375rem}.landing-mark{width:72px;height:72px}.landing-hero h1{max-width:12ch;margin:0;color:var(--sl-color-white);font-size:2.75rem;line-height:1.1;letter-spacing:-.025em}.landing-summary{max-width:42rem;margin:0;color:var(--sl-color-gray-3);font-size:1.125rem;line-height:1.5}.landing-actions{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}.landing-cta{display:inline-flex;align-items:center;min-height:44px;border-radius:10px;padding:0 1.25rem;background:var(--ac-cta);color:var(--ac-cta-fg);font-weight:700;text-decoration:none}.landing-actions code{display:flex;gap:.5rem;align-items:center;min-height:44px;border:1px solid var(--sl-color-hairline);border-radius:10px;padding:0 1rem;background:var(--sl-color-gray-6);color:var(--sl-color-gray-1);font-size:.875rem}.landing-actions code span{color:var(--sl-color-gray-3)}.landing-actions code .landing-prompt{user-select:none}
  .landing-figure-one{display:grid;align-content:center;gap:1.25rem;margin:0}.landing-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.875rem;align-items:center}.landing-node{display:grid;align-content:center;gap:.35rem;min-height:0;border:1px solid var(--sl-color-gray-4);border-radius:10px;padding:.875rem .625rem;background:var(--sl-color-gray-6);color:var(--sl-color-gray-3);font:500 .75rem/1.6 var(--sl-font-mono);text-align:center}.landing-node strong{color:var(--sl-color-white);font-size:.75rem}.landing-node-hot{border-color:var(--sl-color-orange);background:var(--sl-color-orange-low);color:var(--sl-color-orange-high)}.landing-node-hot strong{color:var(--sl-color-orange-high)}.landing-node-cool{border-color:var(--sl-color-green);background:var(--sl-color-green-low);color:var(--sl-color-green-high)}.landing-node-cool strong{color:var(--sl-color-green-high)}.landing-arrow{display:grid;gap:.25rem;margin:0;color:var(--sl-color-gray-4);font:500 .6875rem/1.6 var(--sl-font-mono);text-align:center;white-space:nowrap}.landing-arrow span{font-size:.65rem}.landing-arrow-ai span{color:var(--sl-color-orange-high)}.landing-arrow-ok span{color:var(--sl-color-green-high)}.landing-heal-pill{justify-self:center;margin:0;border:1px dashed var(--sl-color-gray-4);border-radius:10px;padding:.5rem .875rem;color:var(--sl-color-gray-3);font:500 .6875rem/1.4 var(--sl-font-mono);text-align:center}.landing-figure-one figcaption{margin-top:.25rem;text-align:center}
  .landing-section{display:grid;grid-template-columns:minmax(18rem,380px) minmax(0,1fr);gap:4rem;padding:3.5rem 0;border-top:1px solid var(--sl-color-hairline)}.landing-section h2{margin:.7rem 0 0;color:var(--sl-color-white);font-size:1.625rem;line-height:1.2;letter-spacing:-.02em}.landing-section>div>p:not(.ac-label){max-width:34rem;color:var(--sl-color-gray-3);line-height:1.65}.landing-ledger{border-top:1px solid var(--sl-color-hairline)}.landing-ledger-row{display:grid;grid-template-columns:56px minmax(9rem,260px) minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1.35rem 0;border-bottom:1px solid var(--sl-color-hairline)}.landing-ledger-row>span{font-size:1.75rem;font-weight:800;letter-spacing:-.04em;color:var(--sl-color-gray-4)}.landing-ledger-row code{color:var(--sl-color-white);font-size:.9rem}.landing-ledger-row p{margin:0;color:var(--sl-color-gray-3);font-size:.9rem;line-height:1.55}.landing-ledger-row b{border-radius:999px;padding:.32rem .55rem;font:700 .65rem/1 var(--sl-font-mono);white-space:nowrap}.landing-ledger-ai{background:var(--sl-color-orange-low);color:var(--sl-color-orange-high)}.landing-ledger-ok{background:var(--sl-color-green-low);color:var(--sl-color-green-high)}.landing-prerequisites dl{display:grid;grid-template-columns:140px minmax(0,1fr);gap:0;margin:0;border-top:1px solid var(--sl-color-hairline)}.landing-prerequisites dt,.landing-prerequisites dd{margin:0;padding:1.15rem 0;border-bottom:1px solid var(--sl-color-hairline);line-height:1.55}.landing-prerequisites dt{color:var(--sl-color-gray-3);font:500 .75rem var(--sl-font-mono);text-transform:uppercase}.landing-prerequisites dd{color:var(--sl-color-gray-1)}.landing-footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--sl-color-hairline);padding:1.5rem 0 0}.landing-footer nav{display:flex;flex-wrap:wrap;gap:1rem}.landing-footer a{color:var(--sl-color-gray-3);font-size:.8125rem;text-decoration:none}.landing-footer a:hover{color:var(--sl-color-white)}
  @media (max-width:71.99rem){.landing-page{width:min(100% - 4rem,84rem)}.landing-hero{grid-template-columns:1fr}.landing-figure-one{max-width:720px}.landing-section{grid-template-columns:1fr;gap:2rem}}@media (max-width:49.99rem){.landing-page{width:min(100% - 2.5rem,84rem);padding-top:2.5rem}.landing-hero h1{font-size:2.25rem}.landing-flow{grid-template-columns:1fr}.landing-arrow{padding:.15rem 0}.landing-ledger-row{grid-template-columns:44px 1fr}.landing-ledger-row p,.landing-ledger-row b{grid-column:2}.landing-prerequisites dl{grid-template-columns:1fr}.landing-prerequisites dt{padding-bottom:.25rem;border-bottom:0}.landing-prerequisites dd{padding-top:.25rem}.landing-footer{flex-direction:column}}
</style>
