---
import Demo from './Demo.astro';
import type { LandingCopy } from '../content/en-landing.ts';
import { formatPrerequisite, splitHealNote } from '../scripts/landing-format.ts';

interface Props {
  copy: LandingCopy;
  locale: 'en' | 'ja' | 'zh-cn';
}

const { copy, locale } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mark = `${base}ambercast-mark.svg`;
const { lead: healLead, tail: healTail } = splitHealNote(copy.figureOne.healPill);
// The tokenizer treats only ASCII letters and digits as word characters: underscores and CJK
// text are boundaries, unlike `\b`. It preserves the approved source text, and Astro's automatic
// escaping is the safety boundary for every fragment returned to this template.
const splitValue = (value: string) => value.split(/(?<![A-Za-z0-9])(claude|codex)(?![A-Za-z0-9])/g);
---

<!-- The explicit locale keeps one structural contract without deriving language from document state or duplicating approved copy. -->
<div class="landing-page">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-copy">
      <img class="landing-mark" src={mark} alt="" width="72" height="72" />
      <p class="ac-label">{copy.hero.eyebrow}</p>
      <h1 id="landing-title">{copy.hero.title}</h1>
      <p class="landing-summary">{copy.hero.summary}</p>
      <div class="landing-actions">
        <a class="landing-cta" href={`${base}guides/getting-started/`}>{copy.hero.primaryCta}</a>
        <code><span aria-hidden="true" class="landing-prompt">$</span>{copy.hero.installCommand}</code>
      </div>
    </div>
    <!-- The figure owns its spotlight so the flow remains the grid that places nodes and the heal note. -->
    <figure class="landing-exhibit landing-figure-one" data-exhibit="figure">
      <div class="landing-flow">
        <div class="landing-node"><strong>{copy.figureOne.sourceNode}</strong><span>{copy.figureOne.sourceCaption}</span></div>
        <p class="landing-arrow landing-arrow-ai">{copy.figureOne.generateLabel} →<span>{copy.figureOne.generateCallout}</span></p>
        <div class="landing-node landing-node-hot"><strong>{copy.figureOne.castNode}</strong><span>plan.json<br />grounding.json</span></div>
        <p class="landing-arrow landing-arrow-ok">{copy.figureOne.runLabel} →<span>{copy.figureOne.runCallout}</span></p>
        <div class="landing-node landing-node-cool"><strong>{copy.figureOne.replayNode}</strong><span>6/6 · 2.4s</span></div>
        <p class="landing-heal-note"><span class="landing-heal-lead">{healLead}</span>{healTail}</p>
      </div>
      <figcaption class="ac-label">{copy.figureOne.caption}</figcaption>
    </figure>
  </section>
  <Demo labels={copy.demo} />
  <section class="landing-section landing-commands" aria-labelledby="commands-heading">
    <div><p class="ac-label">{copy.commands.eyebrow}</p><h2 id="commands-heading">{copy.commands.heading}</h2></div>
    <div class="landing-ledger">
      {copy.commands.rows.map((row) => (
        <article class="landing-ledger-row">
          <span>{row.number}</span><code>{row.command}</code><p>{row.description}</p><b class:list={{ 'landing-ledger-ai': row.status.startsWith('AI'), 'landing-ledger-ok': row.status.startsWith('REPLAY') }}>{row.status}</b>
        </article>
      ))}
    </div>
  </section>
  <section class="landing-section landing-prerequisites" aria-labelledby="prerequisites-heading">
    <div><p class="ac-label">{copy.prerequisites.eyebrow}</p><h2 id="prerequisites-heading">{copy.prerequisites.heading}</h2><p>{copy.prerequisites.summary}</p></div>
    <dl>
      {copy.prerequisites.entries.map((entry) => {
        const { value, separator, note } = formatPrerequisite(entry.description, locale);
        const wholeCode = value === 'Node.js ≥ 22.14' || value === 'npx playwright-core install chromium';
        return <>
          <dt>{entry.term}</dt>
          <dd><span class="landing-prereq-value">{wholeCode ? <code>{value}</code> : splitValue(value).map((part) => part === 'claude' || part === 'codex' ? <code>{part}</code> : part)}</span>{separator && <span class="landing-prereq-sep">{separator}</span>}{note && <span class="landing-prereq-note">{note.split('ai.provider: "auto"').map((part, index) => <>{index > 0 && <code>ai.provider: "auto"</code>}{part}</>)}</span>}</dd>
        </>;
      })}
    </dl>
  </section>
  <footer class="landing-footer">
    <nav aria-label="Project links"><a href="https://github.com/Tsubaki01/ambercast">{copy.footer.github}</a><a href="https://www.npmjs.com/package/ambercast">{copy.footer.npm}</a><a href="https://github.com/Tsubaki01/ambercast/blob/main/CHANGELOG.md">{copy.footer.changelog}</a><span>{copy.footer.license}</span></nav>
    <span class="ac-label">{copy.footer.specimen}</span>
  </footer>
</div>

<style is:global>
  /* Geometry is theme-independent; dark selectors below contain every lighting treatment so light retains its token-driven surface. */
  /* The approved-copy arrow labels are longer than the finalized design placeholders, so the diagram column is 640px and the arrows wrap. */
  .landing-page{width:min(100% - 6rem,84rem);margin:0 auto;padding:0}.landing-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,640px);gap:64px;align-items:center;padding:72px 0 56px;overflow:visible;isolation:isolate}.landing-hero::before{position:absolute;z-index:-1;top:-360px;right:-200px;left:-200px;height:900px;pointer-events:none;content:""}.landing-hero-copy{display:grid;align-content:start;justify-items:start;gap:22px}.landing-mark{width:72px;height:72px}.landing-hero h1{margin:0;color:var(--sl-color-white);font-size:44px;font-weight:800;line-height:1.1;letter-spacing:-.025em}.landing-summary{max-width:640px;margin:0;color:var(--sl-color-gray-3);font-size:18px;line-height:1.5}.landing-actions{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}.landing-cta{display:inline-flex;align-items:center;min-height:44px;border-radius:10px;padding:0 1.25rem;background:var(--ac-cta);color:var(--ac-cta-fg);font-weight:700;text-decoration:none}.landing-actions code{display:flex;gap:.5rem;align-items:center;min-height:44px;border:1px solid var(--sl-color-hairline);border-radius:10px;padding:0 1rem;background:var(--sl-color-gray-6);color:var(--sl-color-gray-1);font-size:.875rem}.landing-actions code span{color:var(--sl-color-gray-3)}.landing-actions code .landing-prompt{user-select:none}
  .landing-exhibit{position:relative;isolation:isolate}.landing-figure-one{display:grid;align-content:center;gap:1.25rem;margin:0}.landing-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:16px 14px;align-items:center}.landing-node{display:grid;align-content:center;gap:.35rem;min-height:0;border:1px solid var(--sl-color-gray-4);border-radius:10px;padding:18px 12px;background:var(--sl-color-gray-6);color:var(--sl-color-gray-3);font:500 13px/1.6 var(--sl-font-mono);text-align:center;word-break:keep-all}.landing-node strong{color:var(--sl-color-white);font-size:13px}.landing-node-hot{border-color:var(--sl-color-orange);background:var(--sl-color-orange-low);color:var(--sl-color-orange-high)}.landing-node-hot strong{color:var(--sl-color-orange-high)}.landing-node-cool{border-color:var(--sl-color-green);background:var(--sl-color-green-low);color:var(--sl-color-green-high)}.landing-node-cool strong{color:var(--sl-color-green-high)}.landing-arrow{display:grid;gap:.25rem;justify-self:center;max-width:5.5rem;margin:0;color:var(--sl-color-gray-4);font:500 .6875rem/1.6 var(--sl-font-mono);text-align:center;white-space:normal}.landing-arrow span{font-size:.65rem}.landing-arrow-ai span{color:var(--sl-color-orange-high)}.landing-arrow-ok span{color:var(--sl-color-green-high)}.landing-heal-note{grid-column:2/5;justify-self:center;margin:0;padding:2px 0 0;color:var(--sl-color-gray-3);font:500 11px/1.4 var(--sl-font-mono);letter-spacing:.02em;text-align:center}.landing-heal-lead{font-weight:500}.landing-figure-one figcaption{margin-top:.25rem;text-align:center}
  .landing-section{display:grid;grid-template-columns:minmax(18rem,380px) minmax(0,1fr);gap:64px;padding:64px 0;border-top:1px solid var(--sl-color-hairline)}.landing-section h2{margin:.7rem 0 0;color:var(--sl-color-white);font-size:1.625rem;line-height:1.2;letter-spacing:-.02em}.landing-section>div>p:not(.ac-label){max-width:34rem;color:var(--sl-color-gray-3);line-height:1.65}.landing-ledger,.landing-prerequisites dl{border:1px solid var(--sl-color-hairline);border-radius:14px;padding:0 24px}.landing-ledger-row{display:grid;grid-template-columns:56px minmax(9rem,260px) minmax(0,1fr) auto;gap:28px;align-items:center;padding:22px 0;border-bottom:1px solid var(--sl-color-hairline);transition:background .3s}.landing-ledger-row>*{margin-top:0}.landing-ledger-row:last-child{border-bottom:0}.landing-ledger-row>span{font-size:28px;font-weight:800;letter-spacing:-.04em;color:var(--sl-color-gray-4)}.sl-markdown-content .landing-ledger-row code{color:var(--sl-color-white);font:500 15px/1 var(--sl-font-mono);background:transparent}.landing-ledger-row p{margin:0;color:var(--sl-color-gray-3);font-size:15px;line-height:1.6}.landing-ledger-row b{display:inline-flex;align-items:center;height:22px;border-radius:999px;padding:0 9px;font:700 11px/1 var(--sl-font-mono);letter-spacing:.04em;white-space:nowrap}.landing-ledger-row b::before{width:7px;height:7px;margin-right:5px;border-radius:50%;background:currentColor;content:""}.landing-ledger-ai{background:var(--sl-color-orange-low);color:var(--sl-color-orange-high)}.landing-ledger-ok{background:var(--sl-color-green-low);color:var(--sl-color-green-high)}.landing-prerequisites dl{display:grid;grid-template-columns:140px minmax(0,1fr);gap:0;margin:0}.landing-prerequisites dt,.landing-prerequisites dd{margin:0;padding:16px 0;border-bottom:1px solid var(--sl-color-hairline);line-height:1.55}.landing-prerequisites dt{padding-top:20px;color:var(--sl-color-gray-3);font:500 11px/1.55 var(--sl-font-mono);letter-spacing:.12em;text-transform:uppercase}.landing-prerequisites dd{color:var(--sl-color-gray-1)}.landing-prerequisites dt:nth-last-of-type(1),.landing-prerequisites dd:last-of-type{border-bottom:0}.landing-prereq-sep{}.landing-prereq-note{}.landing-footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--sl-color-hairline);padding:28px 0}.landing-footer nav{display:flex;flex-wrap:wrap;gap:1rem}.landing-footer a,.landing-footer nav span{font-size:13px;text-decoration:none}.landing-footer a{color:var(--sl-color-gray-3)}.landing-footer a:hover{color:var(--sl-color-white)}
  /* These pseudo-elements reserve their geometry in both themes; only dark gives them paint, and light explicitly hides the three lighting surfaces. */
  /* Lightning CSS folds direct declarations into only the prefixed form, so var() preserves the standard declaration. */
  [data-theme="light"] .landing-hero::before,[data-theme="light"] .landing-exhibit::before,[data-theme="light"] .landing-section::before{display:none}
  @media (max-width:71.99rem){.landing-page{width:min(100% - 4rem,84rem)}.landing-hero{grid-template-columns:1fr;gap:48px}.landing-figure-one{max-width:720px}.landing-section{grid-template-columns:1fr;gap:32px}}@media (max-width:49.99rem){.landing-page{width:min(100% - 2.5rem,84rem)}.landing-hero{gap:36px;padding:40px 0}.landing-hero h1{font-size:36px}.landing-flow{grid-template-columns:1fr;gap:10px}.landing-arrow{max-width:none;padding:.15rem 0}.landing-heal-note{grid-column:1}.landing-ledger-row{grid-template-columns:40px 1fr}.landing-ledger-row p,.landing-ledger-row b{grid-column:2}.landing-prerequisites dl{grid-template-columns:1fr}.landing-footer{flex-direction:column}.landing-section{padding:40px 0}}
  .landing-exhibit::before,.landing-section::before{position:absolute;z-index:-1;pointer-events:none;content:""}.landing-exhibit::before{top:-260px;right:-120px;left:-120px;height:640px}.landing-section{position:relative}.landing-section::before{top:0;right:0;left:0;height:200px}.landing-prereq-sep{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.landing-prereq-value{font:500 14px/1.55 var(--sl-font-mono)}.landing-prereq-note{display:block;font-size:15px;line-height:1.6}.landing-prerequisites dd code{padding:0;background:transparent;font:500 14px/1.55 var(--sl-font-mono)}
  [data-theme="dark"] .landing-hero::before{background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(201,118,43,.22),rgba(201,118,43,.06) 50%,transparent 78%)}[data-theme="dark"] .landing-exhibit::before{background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(232,176,99,.16),rgba(201,118,43,.05) 50%,transparent 80%)}[data-theme="dark"] .landing-exhibit[data-exhibit="figure"]::before{background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(232,176,99,.44),rgba(201,118,43,.12) 50%,transparent 80%)}[data-theme="dark"] .landing-node{color:var(--ac-resin-0);background:rgba(255,236,210,.07);border-color:rgba(241,205,152,.28);box-shadow:0 1px 0 rgba(255,245,230,.32) inset,0 -1px 0 rgba(255,245,230,.06) inset,0 18px 40px -18px rgba(0,0,0,.85);--ac-node-glass:blur(18px) saturate(1.3);backdrop-filter:var(--ac-node-glass)}[data-theme="dark"] .landing-node strong{color:var(--ac-resin-0)}[data-theme="dark"] .landing-node>span,[data-theme="dark"] .landing-arrow,[data-theme="dark"] .landing-heal-note,[data-theme="dark"] .landing-figure-one figcaption,[data-theme="dark"] .landing-prerequisites dt,[data-theme="dark"] .landing-ledger-row p,[data-theme="dark"] .landing-prereq-note{color:var(--ac-resin-300)}[data-theme="dark"] .landing-node-hot,[data-theme="dark"] .landing-node-hot strong,[data-theme="dark"] .landing-node-hot span,[data-theme="dark"] .landing-node-cool,[data-theme="dark"] .landing-node-cool strong,[data-theme="dark"] .landing-node-cool span{color:var(--ac-resin-0)}[data-theme="dark"] .landing-heal-lead,[data-theme="dark"] .landing-prerequisites dd code,[data-theme="dark"] .sl-markdown-content .landing-ledger-row code{color:var(--sl-color-gray-1)}[data-theme="dark"] .landing-node-hot{background:rgba(219,145,64,.18);border-color:rgba(232,176,99,.7);box-shadow:0 1px 0 rgba(255,245,230,.4) inset,0 0 36px rgba(219,145,64,.35),0 18px 40px -18px rgba(0,0,0,.85)}[data-theme="dark"] .landing-node-cool{background:rgba(127,200,169,.10);border-color:rgba(127,200,169,.45)}[data-theme="dark"] .landing-section{border-top-color:rgba(166,92,31,.28)}[data-theme="dark"] .landing-section::before{background:radial-gradient(ellipse 40% 100% at 22% 0,rgba(232,176,99,.10),transparent 75%)}[data-theme="dark"] .landing-ledger,[data-theme="dark"] .landing-prerequisites dl{background:#1C1612;border-color:rgba(201,118,43,.30);box-shadow:0 1px 0 rgba(241,205,152,.25) inset,0 24px 50px -28px rgba(0,0,0,.95)}[data-theme="dark"] .landing-ledger-row,[data-theme="dark"] .landing-prerequisites dt,[data-theme="dark"] .landing-prerequisites dd{border-color:rgba(166,92,31,.28)}[data-theme="dark"] .landing-ledger-row>span{color:#C9762B}[data-theme="dark"] .landing-ledger-row:hover{background:linear-gradient(90deg,rgba(201,118,43,.07),transparent 60%)}[data-theme="dark"] .landing-footer{border-color:rgba(166,92,31,.28);background:linear-gradient(0deg,rgba(201,118,43,.06),transparent)}[data-theme="dark"] .landing-footer a,[data-theme="dark"] .landing-footer nav span{color:var(--ac-resin-300)}[data-theme="dark"] .sl-markdown-content .landing-actions code{background:#2E2620;border-color:rgba(201,118,43,.38)}
  /* This selector matches the competing specificity, and its final declaration order makes reduced motion win. */
  @media (prefers-reduced-motion:reduce){[data-theme] .landing-ledger-row,.landing-ledger-row{transition:none}}
</style>
