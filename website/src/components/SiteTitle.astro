---
const { siteTitleHref } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mark = `${base}ambercast-mark.svg`;
---

<!-- The title keeps Starlight's route-derived home link while the public design-system mark avoids a second, hand-drawn logo. -->
<a href={siteTitleHref} class="site-title ac-site-title">
  <img src={mark} alt="" width="28" height="28" />
  <span translate="no">ambercast</span>
</a>
