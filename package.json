{
  "name": "ambercast",
  "version": "0.0.1",
  "description": "Prompt-native E2E testing: AI generates a deterministic, lockfile-like execution plan from natural-language test prompts, replayed with zero AI calls. Under active development.",
  "keywords": [
    "e2e",
    "testing",
    "ai",
    "prompt",
    "automation",
    "deterministic"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsubaki01/ambercast.git"
  },
  "homepage": "https://github.com/Tsubaki01/ambercast#readme",
  "bugs": {
    "url": "https://github.com/Tsubaki01/ambercast/issues"
  },
  "bin": {
    "ambercast": "bin/ambercast.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/plan.json": "./dist/schema/plan.schema.json",
    "./schema/grounding.json": "./dist/schema/grounding.schema.json",
    "./schema/config.json": "./dist/schema/config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "imports": {
    "#core/*": "./src/core/*",
    "#ports/*": "./src/ports/*",
    "#adapters/*": "./src/adapters/*",
    "#usecases/*": "./src/usecases/*",
    "#report/*": "./src/report/*",
    "#config/*": "./src/config/*",
    "#runtime/*": "./src/runtime/*"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsdown && node dist/schema-gen.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs src",
    "test:contract:ai": "vitest run --config vitest.config.contract-ai.ts",
    "test:contract:browser": "vitest run --config vitest.config.contract-browser.ts",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  }
}
